{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slacker-shell",
  "version": "0.0.1",
  "identifier": "com.slacker.shell",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/standalone-assets.cjs",
    "beforeBuildCommand": "node scripts/standalone-assets.cjs && node scripts/pack-runtime.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "浮生半日",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#18181b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*", "resources/runtime/dsh-runtime.zip"]
  }
}

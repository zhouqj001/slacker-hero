# ---- Node / pnpm ----
node_modules/
.pnpm-store/
.pnpm-cache/
.npm-cache/
*.tsbuildinfo
*.log
npm-debug.log*
pnpm-debug.log*

# ---- tsdown 构建产物 (插件 lib/,源码在 src/,pnpm run bundle 重建) ----
shell/plugins/*/lib/

# ---- Tauri 后端构建产物 ----
shell/src-tauri/target/
shell/src-tauri/gen/

# ---- Tauri 运行时前端资源 (standalone-assets.cjs 从 resources + 插件 lib 生成) ----
shell/ui/

# ---- 运行数据 / 临时文件 ----
data/
temp/
*.tmp

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ---- IDE ----
.vscode/
.idea/
*.swp
.DS_Store

